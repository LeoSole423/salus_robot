<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="NavigateRecovery">
      <PipelineSequence>
        <RateController hz="0.333">
          <RecoveryNode number_of_retries="1" name="StablePathPlanning">
            <Fallback name="KeepOrReplanPath">
              <ReactiveSequence name="KeepHealthyPath">
                <Inverter><GlobalUpdatedGoal/></Inverter>
                <IsPathValid path="{path}"/>
                <IsPathHealthValid path="{path}" context="0" expected_state="0" service_name="/path_health/evaluate" server_timeout="500"/>
              </ReactiveSequence>
              <ReactiveSequence name="StopAndWaitForPathData">
                <IsPathHealthValid path="{path}" context="0" expected_state="2" service_name="/path_health/evaluate" server_timeout="500"/>
                <Wait wait_duration="1"/>
                <!-- Waiting must never release the previous blackboard path to FollowPath. -->
                <AlwaysFailure/>
              </ReactiveSequence>
              <Sequence name="ComputeHealthyPath">
                <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
                <IsPathHealthValid path="{candidate_path}" context="1" expected_state="0" service_name="/path_health/evaluate" server_timeout="500"/>
                <CopyPath input_path="{candidate_path}" output_path="{path}"/>
              </Sequence>
            </Fallback>
            <Wait wait_duration="1"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath" server_timeout="500"/>
          <Wait wait_duration="1"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <Sequence name="WaitAndReplan">
          <Wait wait_duration="2"/>
          <Sequence name="ComputeHealthyRecoveryPath">
            <ComputePathToPose goal="{goal}" path="{candidate_path}" planner_id="GridBased"/>
            <IsPathHealthValid path="{candidate_path}" context="1" expected_state="0" service_name="/path_health/evaluate" server_timeout="500"/>
            <CopyPath input_path="{candidate_path}" output_path="{path}"/>
          </Sequence>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
