<?xml version="1.0"?>
<package format="3">
  <name>salus_navigation</name><version>0.1.0</version>
  <description>Navigation, missions and zones for SALUS.</description>
  <maintainer email="leonel.sole423@gmail.com">SALUS maintainers</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclpy</depend>
  <depend>salus_interfaces</depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
