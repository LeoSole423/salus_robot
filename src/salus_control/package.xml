<?xml version="1.0"?>
<package format="3">
  <name>salus_control</name><version>0.1.0</version>
  <description>Vehicle control, simulated actuation and battery logic for SALUS.</description>
  <maintainer email="leonel.sole423@gmail.com">SALUS maintainers</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>salus_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
