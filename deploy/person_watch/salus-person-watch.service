[Unit]
Description=SALUS advisory person detection (independent of navigation)
After=network-online.target mediamtx.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=admin
SupplementaryGroups=video render
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=PYTHONUNBUFFERED=1
Environment=GSETTINGS_BACKEND=memory
WorkingDirectory=/opt/salus-person-watch
ExecStart=/opt/salus-person-watch/venv/bin/python3 /opt/salus-person-watch/person_watch.py --config /opt/salus-person-watch/config.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
Nice=15
CPUWeight=10
CPUQuota=50%
MemoryHigh=512M
MemoryMax=768M
TasksMax=96
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
