# Non-secret deployment settings. Keep NTRIP credentials in the ignored local
# file referenced by SALUS_NTRIP_CONFIG_PATH, never in this file.
SALUS_NTRIP_CONFIG_PATH=/opt/salus_robot/src/salus_hardware/config/rtk_sources.local.yaml
SALUS_FCU_URL=/dev/ttyACM0:921600
SALUS_SERIAL_PORT=/dev/ttyUSB0
SALUS_USE_KEEPOUT=true
SALUS_ZONES_RUNTIME_DIR=/ros2_ws/log/real-mvp-zones
SALUS_PATROL_RUNTIME_DIR=/ros2_ws/log/runtime/patrol
SALUS_READINESS_TIMEOUT_S=30
# Camera/PTZ settings. Keep the credential only in the local file named by
# SALUS_CAMERA_PASS_FILE; never put it in this file or in ROS parameters.
CAMERA_HOST=192.168.1.64
CAMERA_PORT=80
CAMERA_USER=admin
CAMERA_CHANNEL=1
SALUS_CAMERA_PASS_FILE=/etc/salus/camera.pass
SALUS_CAMERA_PRESETS_FILE=/ros2_ws/log/runtime/camera/presets.json
